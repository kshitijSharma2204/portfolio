{
  "name": "portfolio",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "prebuild": "node scripts/generate-skill-manifest.js && node scripts/check-content.mjs",
    "build": "astro build",
    "postbuild": "node scripts/check-dist.mjs",
    "preview": "astro preview",
    "check": "astro check",
    "media": "node scripts/generate-media.mjs",
    "test:content": "node scripts/check-content.mjs",
    "test:dist": "node scripts/check-dist.mjs",
    "test:e2e": "playwright test",
    "test": "npm run check && npm run build && npm run test:e2e",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist -t",
    "serve": "node scripts/serve-dist.mjs",
    "screenshots": "node scripts/screenshots.mjs",
    "baseline": "node scripts/baseline-inventory.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource-variable/space-grotesk": "5.3.0",
    "astro": "7.4.13"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@axe-core/playwright": "4.14.1",
    "@playwright/test": "1.65.1",
    "@types/node": "22.20.6",
    "gh-pages": "6.3.0",
    "typescript": "6.0.3"
  }
}
