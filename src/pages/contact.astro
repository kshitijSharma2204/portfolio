---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { profile, withBase } from '../lib/content';

const channels = [
  { href: `mailto:${profile.email}`, icon: 'mail' as const, name: 'Email', detail: profile.email, rel: undefined },
  { href: profile.linkedin, icon: 'linkedin' as const, name: 'LinkedIn', detail: 'linkedin.com/in/kshitijsharma1992', rel: 'me noopener' },
  { href: profile.github, icon: 'github' as const, name: 'GitHub', detail: 'github.com/kshitijSharma2204', rel: 'me noopener' },
  { href: withBase('resume.pdf'), icon: 'file' as const, name: 'Résumé', detail: 'PDF download', rel: undefined },
];
---
<BaseLayout
  title={`Contact | ${profile.name}`}
  description={`Contact ${profile.name}, ${profile.title}, by email, LinkedIn or GitHub, or download the résumé.`}
>
  <div class="container page-head">
    <nav class="breadcrumbs" aria-label="Breadcrumb">
      <ol>
        <li><a href={withBase('')}>Home</a></li>
        <li><span aria-current="page">Contact</span></li>
      </ol>
    </nav>
    <span class="eyebrow">Contact</span>
    <h1>Get in touch</h1>
    <p class="lead">Email me, find me on LinkedIn and GitHub, or download my résumé.</p>
  </div>
  <div class="container">
    <ul class="channels">
      {channels.map((c) => (
        <li>
          <a class="channel card" href={c.href} rel={c.rel}>
            <span class="ch-icon"><Icon name={c.icon} size={24} /></span>
            <span>
              <span class="ch-name">{c.name}</span>
              <span class="ch-detail mono">{c.detail}</span>
            </span>
            <span class="ch-arrow"><Icon name="arrow" /></span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</BaseLayout>

<style>
  .channels {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--s5);
  }
  .channel {
    display: flex;
    align-items: center;
    gap: var(--s4);
    padding: var(--s5);
    color: var(--text);
    text-decoration: none;
    height: 100%;
    transition: border-color 0.15s;
  }
  .channel:hover { border-color: var(--accent); color: var(--text); }
  .ch-icon { display: grid; place-items: center; width: 48px; height: 48px; border-radius: 12px; background: var(--accent-soft); color: var(--accent); flex: none; }
  .ch-name { display: block; font-family: var(--font-head); font-weight: 600; font-size: 1.125rem; }
  .ch-detail { display: block; font-size: 0.8125rem; color: var(--muted); overflow-wrap: anywhere; }
  .ch-arrow { margin-left: auto; color: var(--muted); }
  @media (max-width: 900px) {
    .channels { grid-template-columns: minmax(0, 1fr); }
  }
</style>
