---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import ProjectCard from '../components/ProjectCard.astro';
import ProjectMedia from '../components/ProjectMedia.astro';
import QuickView from '../components/QuickView.astro';
import {
  currentRole,
  education,
  experience,
  featuredProjects,
  profile,
  projects,
  resumeSkills,
  skillIcons,
  withBase,
} from '../lib/content';

const hero = featuredProjects[0];
const highlights = experience.slice(0, 3);
const earlier = experience.slice(3);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfilePage',
  url: profile.siteUrl,
  mainEntity: {
    '@type': 'Person',
    '@id': `${profile.siteUrl}#person`,
    name: profile.name,
    url: profile.siteUrl,
    description: profile.description,
    image: new URL(withBase(profile.photo.src), Astro.site).href,
    jobTitle: currentRole.role,
    worksFor: { '@type': 'Organization', name: currentRole.employer },
    alumniOf: { '@type': 'CollegeOrUniversity', name: 'Worcester Polytechnic Institute' },
    sameAs: [profile.github, profile.linkedin],
  },
};
---
<BaseLayout
  title={`${profile.name} | ${profile.title}`}
  description={profile.description}
  type="profile"
  jsonLd={jsonLd}
>
  <section class="hero" aria-labelledby="hero-title">
    <div class="container hero-grid">
      <div class="hero-copy">
        <span class="eyebrow">Robotics / Perception Engineering</span>
        <h1 id="hero-title">{profile.name}</h1>
        <p class="hero-title">{profile.title}</p>
        <p class="hero-role">
          <span class="badge badge-dot">Current role</span>
          <span><strong>{currentRole.role}</strong> at <strong>{currentRole.employer}</strong></span>
        </p>
        <p class="lead">{profile.description}</p>
        <div class="btn-row">
          <a class="btn btn-primary" href={withBase('projects/')}>Explore projects <Icon name="arrow" size={16} /></a>
          <a class="btn" href={withBase('experience/')}>Experience</a>
          <a class="btn" href={withBase('resume.pdf')}><Icon name="file" size={16} /> Résumé</a>
        </div>
        <ul class="hero-social">
          <li><a href={profile.github} rel="me noopener"><Icon name="github" /> <span>GitHub</span></a></li>
          <li><a href={profile.linkedin} rel="me noopener"><Icon name="linkedin" /> <span>LinkedIn</span></a></li>
        </ul>
      </div>

      <div class="hero-visual">
        <div class="viewer card">
          <div class="viewer-bar mono" aria-hidden="true">
            <span class="dots"><i></i><i></i><i></i></span>
            <span>{hero.slug}</span>
          </div>
          <ProjectMedia project={hero} playable eager sizes="(max-width: 900px) 100vw, 580px" />
          <div class="viewer-cap">
            <a href={withBase(`projects/${hero.slug}/`)}>{hero.name} <Icon name="arrow" size={16} /></a>
            <span class="mono muted">{hero.skills.slice(0, 4).join(' · ')}</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section id="experience" class="section" aria-labelledby="exp-title">
    <div class="container">
      <div class="section-head">
        <div>
          <span class="eyebrow">Professional experience</span>
          <h2 id="exp-title">Where I’ve worked</h2>
        </div>
        <a class="link-arrow" href={withBase('experience/')}>View full timeline →</a>
      </div>
      <ol class="exp-grid">
        {highlights.map((e) => (
          <li class="exp-card card">
            <div class="exp-top">
              <p class="exp-employer">{e.employer}</p>
              {e.current && <span class="badge badge-dot">Current role</span>}
            </div>
            {e.client && <p class="exp-client muted">Client: {e.client}</p>}
            <h3 class="exp-role">{e.role}</h3>
            <p class="exp-date mono muted">{e.date}</p>
          </li>
        ))}
      </ol>
      <p class="exp-earlier muted">
        Earlier:{' '}
        {earlier.map((e, i) => (
          <>
            <span><strong>{e.employer}</strong> ({e.role})</span>{i < earlier.length - 1 ? ' · ' : ''}
          </>
        ))}
      </p>
    </div>
  </section>

  <section id="projects" class="section" aria-labelledby="proj-title">
    <div class="container">
      <div class="section-head">
        <div>
          <span class="eyebrow">Selected projects</span>
          <h2 id="proj-title">Perception, SLAM and motion planning</h2>
        </div>
        <a class="link-arrow" href={withBase('projects/')}>All {projects.length} projects →</a>
      </div>
      <div class="grid-3">
        {featuredProjects.map((p) => <ProjectCard project={p} />)}
      </div>
      <p class="center">
        <a class="btn" href={withBase('projects/')}>Browse all {projects.length} projects <Icon name="arrow" size={16} /></a>
      </p>
    </div>
  </section>

  <section class="section" aria-label="Expertise and education">
    <div class="container split">
      <div id="skills">
        <span class="eyebrow">Technical expertise</span>
        <h2>Skills</h2>
        <ul class="skill-grid">
          {skillIcons.map((s) => (
            <li class="skill">
              <span class="skill-plate">
                <img src={withBase(s.src)} width={s.width} height={s.height} alt="" loading="lazy" decoding="async" />
              </span>
              <span class="skill-label mono">{s.label}</span>
            </li>
          ))}
        </ul>
        <dl class="skill-lists">
          {resumeSkills.map((g) => (
            <div>
              <dt>{g.label}</dt>
              <dd>{g.items.join(' · ')}</dd>
            </div>
          ))}
        </dl>
      </div>

      <div id="bio">
        <div class="about-head">
          <img class="about-photo" src={withBase(profile.photo.src)} width={profile.photo.width} height={profile.photo.height}
            alt={`Photo of ${profile.name}`} loading="lazy" decoding="async" />
          <div>
            <span class="eyebrow">About / Education</span>
            <h2>Education</h2>
          </div>
        </div>
        <ul class="edu">
          {education.map((ed) => (
            <li class="card">
              <p class="edu-degree">{ed.degree}</p>
              <p class="edu-school">{ed.school}</p>
              <p class="mono muted edu-date">{ed.dates}</p>
              {ed.detail && <p class="muted edu-detail">{ed.detail}</p>}
            </li>
          ))}
        </ul>
        <a class="link-arrow" href={withBase('about/')}>Read my full bio →</a>
      </div>
    </div>
  </section>

  <section id="contact" class="section" aria-labelledby="contact-title">
    <div class="container">
      <div class="contact card">
        <div>
          <span class="eyebrow">Contact</span>
          <h2 id="contact-title">Get in touch</h2>
          <p class="muted">Email <a href={`mailto:${profile.email}`}>{profile.email}</a>, find me on GitHub and LinkedIn, or download my résumé.</p>
        </div>
        <div class="btn-row">
          <a class="btn" href={`mailto:${profile.email}`}><Icon name="mail" size={16} /> Email</a>
          <a class="btn" href={profile.github} rel="me noopener"><Icon name="github" size={16} /> GitHub</a>
          <a class="btn" href={profile.linkedin} rel="me noopener"><Icon name="linkedin" size={16} /> LinkedIn</a>
          <a class="btn btn-primary" href={withBase('resume.pdf')}><Icon name="file" size={16} /> Résumé</a>
        </div>
      </div>
    </div>
  </section>

  <QuickView projects={featuredProjects} />
</BaseLayout>

<style>
  .hero {
    position: relative;
    padding-block: var(--s8);
    background-image:
      linear-gradient(var(--grid-line) 1px, transparent 1px),
      linear-gradient(90deg, var(--grid-line) 1px, transparent 1px);
    background-size: 32px 32px;
    background-position: -1px -1px;
    border-bottom: 1px solid var(--border);
  }
  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
    gap: var(--s7);
    align-items: center;
  }
  .hero h1 { font-size: clamp(2.75rem, 7vw, 4.5rem); margin-bottom: var(--s2); letter-spacing: -0.03em; }
  .hero-title {
    font-family: var(--font-head);
    font-size: clamp(1.25rem, 2.6vw, 1.75rem);
    font-weight: 500;
    margin-bottom: var(--s4);
  }
  .hero-role { display: flex; flex-wrap: wrap; align-items: center; gap: var(--s2) var(--s3); margin-bottom: var(--s4); }
  .hero .lead { margin-bottom: var(--s5); }
  .hero-social { list-style: none; display: flex; gap: var(--s5); padding: 0; margin: var(--s5) 0 0; }
  .hero-social a { display: inline-flex; align-items: center; gap: var(--s2); min-height: 44px; color: var(--muted); text-decoration: none; font-weight: 500; }
  .hero-social a:hover { color: var(--accent); }

  .viewer { overflow: hidden; box-shadow: var(--shadow); }
  .viewer-bar {
    display: flex;
    align-items: center;
    gap: var(--s3);
    padding: var(--s2) var(--s4);
    font-size: 0.75rem;
    color: var(--muted);
    border-bottom: 1px solid var(--border);
  }
  .dots { display: inline-flex; gap: 6px; }
  .dots i { width: 9px; height: 9px; border-radius: 50%; background: var(--border); }
  .viewer-cap {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--s2) var(--s4);
    padding: var(--s3) var(--s4);
    border-top: 1px solid var(--border);
    font-size: 0.875rem;
  }
  .viewer-cap a { display: inline-flex; align-items: center; gap: 6px; font-weight: 600; text-decoration: none; }
  .viewer-cap .mono { font-size: 0.75rem; }

  .exp-grid { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--s5); }
  .exp-card { padding: var(--s5); display: flex; flex-direction: column; gap: var(--s1); }
  .exp-top { display: flex; justify-content: space-between; align-items: start; gap: var(--s3); flex-wrap: wrap; }
  .exp-employer { font-family: var(--font-head); font-size: 1.25rem; font-weight: 600; margin: 0; }
  .exp-client { margin: 0; font-size: 0.9375rem; }
  .exp-role { font-family: var(--font-body); font-size: 1rem; font-weight: 600; margin: var(--s3) 0 0; }
  .exp-date { margin: 0; font-size: 0.8125rem; }
  .exp-earlier { margin: var(--s5) 0 0; font-size: 0.9375rem; }
  .exp-earlier strong { color: var(--text); font-weight: 600; }

  .center { text-align: center; margin: var(--s6) 0 0; }

  .split { display: grid; grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr); gap: var(--s7); }
  .skill-grid {
    list-style: none;
    padding: 0;
    margin: 0 0 var(--s5);
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(108px, 1fr));
    gap: var(--s3);
  }
  .skill { display: flex; flex-direction: column; align-items: center; gap: var(--s2); }
  .skill-plate {
    width: 100%;
    height: 72px;
    display: grid;
    place-items: center;
    padding: var(--s3);
    background: #fff;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
  }
  .skill-plate img { max-height: 44px; width: auto; object-fit: contain; }
  .skill-label { font-size: 0.6875rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--muted); text-align: center; }
  .skill-lists { margin: 0; display: grid; gap: var(--s3); }
  .skill-lists dt { font-family: var(--font-mono); font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.08em; color: var(--accent); }
  .skill-lists dd { margin: 2px 0 0; }

  .about-head { display: flex; align-items: center; gap: var(--s4); margin-bottom: var(--s3); }
  .about-head h2 { margin: 0; }
  .about-photo { width: 72px; height: 72px; border-radius: 50%; object-fit: cover; border: 2px solid var(--border); flex: none; }
  .edu { list-style: none; padding: 0; margin: 0 0 var(--s5); display: grid; gap: var(--s3); }
  .edu li { padding: var(--s4) var(--s5); }
  .edu p { margin: 0; }
  .edu-degree { font-weight: 600; font-family: var(--font-head); font-size: 1.125rem; }
  .edu-date { font-size: 0.8125rem; margin-top: var(--s1) !important; }
  .edu-detail { font-size: 0.875rem; margin-top: var(--s2) !important; }

  .contact {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--s5);
    padding: var(--s6);
  }
  .contact h2 { margin-bottom: var(--s2); }
  .contact p { margin: 0; }

  @media (max-width: 900px) {
    .hero { padding-block: var(--s7); }
    .hero-grid { grid-template-columns: minmax(0, 1fr); gap: var(--s6); }
    .exp-grid { grid-template-columns: minmax(0, 1fr); }
    .split { grid-template-columns: minmax(0, 1fr); }
  }
  @media (max-width: 480px) {
    .contact { padding: var(--s5); }
    .hero .btn-row .btn { flex: 1 1 auto; }
  }
</style>
