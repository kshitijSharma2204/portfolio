---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { featuredProjects, profile, withBase } from '../lib/content';
---
<BaseLayout title={`Page not found | ${profile.name}`} description="This page could not be found." noindex>
  <div class="container page-head nf">
    <span class="eyebrow">Error 404</span>
    <h1>Page not found</h1>
    <p class="lead">The page you were looking for doesn’t exist or has moved. These might help:</p>
    <div class="btn-row">
      <a class="btn btn-primary" href={withBase('')}>Home</a>
      <a class="btn" href={withBase('projects/')}>All projects <Icon name="arrow" size={16} /></a>
      <a class="btn" href={withBase('experience/')}>Experience</a>
    </div>
    <h2 class="nf-sub">Selected projects</h2>
    <ul class="nf-list">
      {featuredProjects.map((p) => (
        <li><a href={withBase(`projects/${p.slug}/`)}>{p.name}</a></li>
      ))}
    </ul>
  </div>
</BaseLayout>

<style>
  .nf { min-height: 50vh; }
  .nf-sub { font-size: 1.125rem; margin-top: var(--s7); }
  .nf-list { padding-left: 1.2rem; display: grid; gap: var(--s2); }
</style>
