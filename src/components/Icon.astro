  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill={isFill || name === 'play' ? 'currentColor' : 'none'}
  stroke={isFill ? 'none' : 'currentColor'}
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
  set:html={isFill ? fill[name] : stroke[name]}
