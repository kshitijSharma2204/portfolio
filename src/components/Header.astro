---
import Icon from './Icon.astro';
import { withBase } from '../lib/content';

const path = Astro.url.pathname;
const nav = [
  { href: withBase('projects/'), label: 'Projects' },
  { href: withBase('experience/'), label: 'Experience' },
  { href: withBase('about/'), label: 'About' },
  { href: withBase('contact/'), label: 'Contact' },
];
const isCurrent = (href: string) => path === href || (href !== withBase('') && path.startsWith(href));
---
<header class="site-header" data-header>
  <div class="container bar">
    <a class="brand" href={withBase('')}>
      <span class="mark" aria-hidden="true">KS</span>
      <span class="brand-name">Kshitij Sharma<span class="sr-only"> — home</span></span>
    </a>

    <div class="actions">
      <button class="icon-btn theme-toggle" type="button" data-theme-toggle aria-label="Switch color theme">
        <span class="i-moon"><Icon name="moon" /></span>
        <span class="i-sun"><Icon name="sun" /></span>
      </button>
      <button
        class="icon-btn menu-btn"
        type="button"
        aria-expanded="false"
        aria-controls="site-nav"
        data-menu-toggle
      >
        <span class="sr-only">Menu</span>
        <span class="i-open"><Icon name="menu" /></span>
        <span class="i-close"><Icon name="close" /></span>
      </button>
    </div>

    <nav id="site-nav" class="nav" aria-label="Primary">
      <ul>
        {nav.map((item) => (
          <li>
            <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>{item.label}</a>
          </li>
        ))}
        <li class="cv">
          <a class="btn btn-sm btn-primary" href={withBase('resume.pdf')}>
            <Icon name="file" size={16} /> Résumé
          </a>
        </li>
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--bg) 88%, transparent);
    backdrop-filter: saturate(140%) blur(10px);
    -webkit-backdrop-filter: saturate(140%) blur(10px);
    border-bottom: 1px solid var(--border);
  }
  .bar {
    min-height: var(--header-h);
    display: flex;
    align-items: center;
    gap: var(--s4);
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: var(--s3);
    color: var(--text);
    text-decoration: none;
    font-family: var(--font-head);
    font-weight: 600;
    font-size: 1.0625rem;
    margin-right: auto;
  }
  .brand:hover { color: var(--text); }
  .mark {
    display: inline-grid;
    place-items: center;
    width: 34px;
    height: 34px;
    border-radius: 9px;
    background: var(--accent);
    color: var(--on-accent);
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.02em;
  }
  .nav ul {
    list-style: none;
    display: flex;
    align-items: center;
    gap: var(--s1);
    margin: 0;
    padding: 0;
  }
  .nav a:not(.btn) {
    display: inline-flex;
    align-items: center;
    min-height: 40px;
    padding: 0 var(--s3);
    border-radius: var(--radius-sm);
    color: var(--muted);
    text-decoration: none;
    font-weight: 500;
    font-size: 0.9375rem;
  }
  .nav a:not(.btn):hover { color: var(--text); background: var(--accent-soft); }
  .nav a[aria-current='page'] { color: var(--text); box-shadow: inset 0 -2px 0 var(--accent); border-radius: 0; }
  .cv { margin-left: var(--s2); }
  .actions { display: flex; gap: var(--s2); order: 2; }

  /* Theme toggle shows the icon of the theme you would switch TO. */
  .theme-toggle .i-sun { display: none; }
  :global(:root[data-theme='dark']) .theme-toggle .i-sun { display: contents; }
  :global(:root[data-theme='dark']) .theme-toggle .i-moon { display: none; }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .theme-toggle .i-sun { display: contents; }
    :global(:root:not([data-theme='light'])) .theme-toggle .i-moon { display: none; }
  }
  :global(html:not(.js)) .theme-toggle,
  :global(html:not(.js)) .menu-btn { display: none; }
  .menu-btn { display: none; }
  .menu-btn .i-close { display: none; }
  .menu-btn[aria-expanded='true'] .i-close { display: contents; }
  .menu-btn[aria-expanded='true'] .i-open { display: none; }

  @media (min-width: 821px) {
    .nav { order: 1; }
    .actions { order: 2; }
  }
  @media (max-width: 820px) {
    .bar { flex-wrap: wrap; }
    .brand-name { font-size: 1rem; }
    .nav { order: 3; width: 100%; }
    .nav ul { flex-wrap: wrap; padding-bottom: var(--s3); }
    :global(html.js) .menu-btn { display: inline-grid; }
    :global(html.js) .nav { display: none; }
    :global(html.js) .site-header[data-open] .nav { display: block; }
    :global(html.js) .nav ul { flex-direction: column; align-items: stretch; padding-bottom: var(--s4); }
    :global(html.js) .nav a:not(.btn) { min-height: 48px; font-size: 1.0625rem; }
    :global(html.js) .nav a[aria-current='page'] { box-shadow: inset 3px 0 0 var(--accent); }
    .cv { margin: var(--s2) 0 0; }
    :global(html.js) .cv .btn { width: 100%; min-height: 48px; }
  }
</style>

<script>
  const root = document.documentElement;
  const header = document.querySelector<HTMLElement>('[data-header]');
  const themeBtn = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
  const menuBtn = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const dark = window.matchMedia('(prefers-color-scheme: dark)');

  const effective = () => root.dataset.theme ?? (dark.matches ? 'dark' : 'light');
  const label = () => themeBtn?.setAttribute('aria-label', `Switch to ${effective() === 'dark' ? 'light' : 'dark'} theme`);
  label();
  dark.addEventListener('change', label);
  themeBtn?.addEventListener('click', () => {
    const next = effective() === 'dark' ? 'light' : 'dark';
    root.dataset.theme = next;
    try { localStorage.setItem('theme', next); } catch {}
    label();
  });

  const setOpen = (open: boolean) => {
    menuBtn?.setAttribute('aria-expanded', String(open));
    if (open) header?.setAttribute('data-open', '');
    else header?.removeAttribute('data-open');
  };
  menuBtn?.addEventListener('click', () => setOpen(menuBtn.getAttribute('aria-expanded') !== 'true'));
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && menuBtn?.getAttribute('aria-expanded') === 'true') {
      setOpen(false);
      menuBtn.focus();
    }
  });
  header?.querySelectorAll('.nav a').forEach((a) => a.addEventListener('click', () => setOpen(false)));
</script>
